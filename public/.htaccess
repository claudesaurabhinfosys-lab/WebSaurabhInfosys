Options -MultiViews
RewriteEngine On

# Portfolio API clean URL rewrites
RewriteRule ^api/portfolio/?$ api/portfolio.json [L]
RewriteRule ^api/portfolio/([^/]+)/?$ api/portfolio/$1.json [L]

# Serve pre-built index.html for all clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [QSA,L]

# Fallback to index.html for SPA routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [QSA,L]
